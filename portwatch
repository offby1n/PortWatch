#!/usr/bin/env python3
import socket 
import ipaddress
import argparse
import sys
from datetime import datetime
from pathlib import Path

parser = argparse.ArgumentParser(
    description="PortWatch — a simple Python port scanner",
    epilog="""Examples:
  python PortWatch.py 192.168.1.1
  python PortWatch.py 192.168.1.1 -p 22
  python PortWatch.py 192.168.1.1 -p 20-25 -t 1
""",
    formatter_class=argparse.RawDescriptionHelpFormatter
)


parser.add_argument(
    "ip",
    help="Target IP address to scan (e.g. 192.168.1.1)"
)

parser.add_argument(
    "-p", "--ports",
    default="1-65535",
    help="Port or range to scan: a single port like 22, or a range like 22-443 (default: 1-65535)"
)

parser.add_argument(
    "-t", "--timeout",
    type=float,
    default=0.5,
    metavar="SEC",
    help="Connection timeout in seconds (default: 0.5)"
)

parser.add_argument(
    "-s", "--save",
    action="store_true",
    help="Save open ports to a file"
)

args = parser.parse_args()

flag = 0
Ports = []
data_dir = Path.home() / ".local" / "share" / "portwatch"
data_dir.mkdir(parents=True, exist_ok=True)
log_path = data_dir / "Logs.txt"

try:
    local_ip = args.ip
    ipaddress.ip_address(local_ip)
except ValueError:
    sys.exit(f"Invalid IP address: {args.ip}")
    
    
try:
    if args.timeout <= 0:
        sys.exit("Timeout must be a positive number.")

        
    try:
        if "-" in args.ports:
            start, end = map(int, args.ports.split("-"))
        else:
            start = end = int(args.ports)
    except ValueError:
        sys.exit("Invalid port range. Must be in the format 'start-end' or a single port number.")  
    if start < 0 or end > 65535 or start > end:
        sys.exit("Port numbers must be between 0 and 65535, and the starting port must be less than or equal to the ending port.")
    print(f"Scanning ports from {start} to {end} on IP address {local_ip}...")
    for port in range(start, end + 1):
        Socks = socket.socket()
        try:
            Socks.settimeout(args.timeout)
            Socks.connect((local_ip, port))
            flag = 1
            print(f"!==Port {port} is open==!")
            Ports.append(port)
        except socket.timeout:
            print(f"Port {port} timed out.")
        except ConnectionRefusedError:
            pass
        except socket.error as e:
            print(f"Socket error on port {port}: {e}")
        finally:
            Socks.close()
    print("Scanning complete.")
    if flag == 0:
        print("No open ports found.")
    elif args.save:
        sep = "====================================================\n"

        new_block = ""
        for port in Ports:
            new_block += f"Port: {port} was open at {datetime.now()} — timeout {args.timeout}, ip {local_ip}\n"

        if log_path.exists():
            old_content = log_path.read_text()
        else:
            old_content = ""

        blocks = [b for b in old_content.split(sep) if b.strip()]
        kept = blocks[-2:] + [new_block]

        with open(log_path, "w") as f:
            for block in kept:
                f.write(block)
                f.write(sep)

        print(f"Open ports saved to {log_path}")

except KeyboardInterrupt:
    print("Exiting the program...")
    sys.exit()
       

