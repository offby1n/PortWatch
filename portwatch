#!/usr/bin/env python3
import socket 
import ipaddress
import argparse
import sys

parser = argparse.ArgumentParser(
    description="PortWatch — a simple Python port scanner",
    epilog="""Examples:
  python PortWatch.py 192.168.1.1
  python PortWatch.py 192.168.1.1 -p 22
  python PortWatch.py 192.168.1.1 -p 20-25 -t 1
""",
    formatter_class=argparse.RawDescriptionHelpFormatter
)


parser.add_argument(
    "ip",
    help="Target IP address to scan (e.g. 192.168.1.1)"
)

parser.add_argument(
    "-p", "--ports",
    default="1-65535",
    help="Port or range to scan: a single port like 22, or a range like 22-443 (default: 1-65535)"
)

parser.add_argument(
    "-t", "--timeout",
    type=float,
    default=0.5,
    metavar="SEC",
    help="Connection timeout in seconds (default: 0.5)"
)

args = parser.parse_args()


try:
    local_ip = args.ip
    ipaddress.ip_address(local_ip)
except ValueError:
    sys.exit(f"Invalid IP address: {args.ip}")
    
    
try:
    if args.timeout <= 0:
        sys.exit("Timeout must be a positive number.")

        
    try:
        if "-" in args.ports:
            start, end = map(int, args.ports.split("-"))
        else:
            start = end = int(args.ports)
    except ValueError:
        sys.exit("Invalid port range. Must be in the format 'start-end' or a single port number.")  
    if start < 0 or end > 65535 or start > end:
        sys.exit("Port numbers must be between 0 and 65535, and the starting port must be less than or equal to the ending port.")
    print(f"Scanning ports from {start} to {end} on IP address {local_ip}...")
    for port in range(start, end + 1):
        Socks = socket.socket()
        try:
            Socks.settimeout(args.timeout)
            Socks.connect((local_ip, port))
            print(f"!==Port {port} is open==!")
        except socket.timeout:
            print(f"Port {port} timed out.")
        except ConnectionRefusedError:
            pass
    print("Scanning complete.")
except KeyboardInterrupt:
    print("Exiting the program...")
    sys.exit()
       

